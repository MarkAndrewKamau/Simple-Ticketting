# ---- Paystack -------------------------------------------------------------
# Secret key ONLY. This must never appear in the frontend bundle.
# Use sk_test_... while testing, sk_live_... when you go live.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- MongoDB Atlas --------------------------------------------------------
# Atlas → Connect → Drivers. URL-encode the password if it contains @ : / ? # or %
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB_NAME=family_connection

# ---- Server ---------------------------------------------------------------
# Render sets PORT itself — leave it unset there.
PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call this API.
# In production this is your Render static site URL, e.g.
# https://family-connection.onrender.com
FRONTEND_ORIGIN=http://localhost:5173

# ---- Ticketing ------------------------------------------------------------
PARENT_PRICE_KES=1000
CHILD_PRICE_KES=500

# Flat rate covering a whole household, however many people. Refused after
# OFFER_ENDS_AT — enforced on the server, so a stale browser tab or a tampered
# request cannot buy it late. Include the +03:00 offset or it is read as UTC
# and the offer closes three hours early.
FAMILY_PRICE_KES=2500
OFFER_ENDS_AT=2026-08-12T23:59:59+03:00

MAX_PARENTS_PER_ORDER=10
MAX_CHILDREN_PER_ORDER=20

# Paystack requires an email on every charge. When a parent does not give one
# we synthesise <reference>@<domain>. Change this to your real domain.
FALLBACK_EMAIL_DOMAIN=guest.gracehha.ac.ke

# ---- Admin ----------------------------------------------------------------
# Long random string. Guards GET /api/orders (the attendee list).
# Generate one with: node -e "console.log(crypto.randomUUID())"
ADMIN_TOKEN=change-me-to-something-long-and-random
